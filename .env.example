# ── Base de datos ──
# Neon (cloud): pegar connection string del dashboard con pooling activado
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require

PORT=3008
JWT_SECRET=change_this_in_production
ENCRYPTION_KEY=change_this_encryption_key_in_production

# ── Admins ──
# Correos que siempre son admin (separados por coma). Si no hay ninguno, el primer usuario se promueve.
# ADMIN_EMAILS=tu@correo.com

# ── CORS ──
CORS_ORIGIN=http://localhost:3000

# ── Lucy AI (opcional) ──
LUCY_API_URL=http://localhost:5000
LUCY_API_KEY=

# ── MetaTrader 5 (ZeroMQ) ──
MT_ENABLED=false
MT_ZMQ_HOST=127.0.0.1
MT_ZMQ_PUSH_PORT=5555
MT_ZMQ_PULL_PORT=5556
MT_ORDER_TIMEOUT_MS=5000

# ── Binance (opcional, fallback global si no hay cuenta conectada) ──
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Jupiter (Solana) ──
# API key del portal: https://portal.jup.ag  (también se puede pegar desde Motor > Integraciones)
JUPITER_API_KEY=


# ── Trading Worker ──
WORKER_ENABLED=true
WORKER_CYCLE_SECONDS=30

# ── Firebase Admin (verificación de usuarios + login con Google) ──
# Opción A: ruta al JSON de la cuenta de servicio (no lo subas a git)
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/serviceAccountKey.json
# Opción B: variables sueltas (útil en producción)
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ── Sync de Sequelize ──
# safe (default): crea tablas que falten, no altera las existentes (arranque rápido)
# alter: compara y altera columnas (lento en Neon, usar solo al cambiar modelos)
# false: no toca el esquema
DB_SYNC=safe

# ── Recuperación de contraseña ──
# URL pública del frontend (enlaces del correo)
APP_URL=http://localhost:3000
# Misma API key web de Firebase (Project settings → Your apps). Envía el correo a Gmail.
FIREBASE_WEB_API_KEY=
# SMTP opcional para el correo con branding AutoTrade (Gmail: smtp.gmail.com + App Password)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# En desarrollo se devuelve el enlace en la API. En producción déjalo en false.
# PASSWORD_RESET_RETURN_LINK=true

# ── Logs ──
LOG_DIR=./logs
LOG_LEVEL=info
